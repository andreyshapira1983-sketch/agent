{
  "_what_this_is": "ONE experimental claim certificate. Not a schema, not a format, not a generalisation of main.qm. Every field name here is disposable. What is NOT disposable is the property under test: the semantic decisions below are read and executed by scripts/qm_claim_check.py, not duplicated inside it. Changing a fact here changes what the machine does.",
  "_not_claimed": [
    "No general .qm claim format.",
    "No architecture decision. Conservative artifact-wide invalidation remains sound and merely coarse.",
    "No completeness of the dependency model — it is exactly as complete as the probes that forced it.",
    "No claim that the status vocabulary is right."
  ],
  "claim_id": "C2",
  "claim": {
    "prose": "In the declared evaluation, the run journal's session_start record carries llm_model = gpt-4o-mini.",
    "expected": "gpt-4o-mini"
  },
  "evaluation_domain": {
    "command": [
      "main.py",
      "--ask",
      ":budget-status",
      "--auto-approve",
      "deny"
    ],
    "_why_this_command": "a local command: it exercises session start and model routing without a model call, so the evaluation is cheap and deterministic in the projected dimension.",
    "workspace": "supplied to the evaluation; its `.env` is part of the evaluation, not of the certificate"
  },
  "observation": {
    "_authority": "the validator reads these; it holds no hard-coded knowledge of where the evidence lives or what it is called.",
    "carrier_glob": "logs/run_*.jsonl",
    "bind_to_current_evaluation": true,
    "_why_bind": "the workspace may already contain journals from earlier evaluations. Evidence must come from the run this validator launched, so the validator snapshots the carrier set before running and requires exactly one new file.",
    "require_event": "session_start",
    "_why_require_event": "a record that merely contains the projected key is not the record this claim is about. The event name is checked before the projection is read.",
    "projection_path": [
      "payload",
      "llm_model"
    ]
  },
  "environment_resolution": {
    "_authority": "the ORDER below is the precedence the certificate asserts, and the validator applies it as written. Reversing it here changes the prediction the machine makes.",
    "sources": [
      {
        "id": "D2",
        "source": "process_env",
        "note": "highest precedence"
      },
      {
        "id": "D1",
        "source": "workspace_dotenv",
        "note": "cli/app.py calls load_dotenv without override=True, so it loses to an already-set process variable"
      }
    ]
  },
  "dependency_model": {
    "_authority": "ordered rules, highest precedence first. The first rule whose `when` holds supplies the predicted value AND names the dependency the certificate says is active. Both are compared against the observation.",
    "rules": [
      {
        "id": "D2/D1",
        "what": "AGENT_MODEL, resolved through environment_resolution",
        "when": {
          "key_present": "AGENT_MODEL"
        },
        "value_from": {
          "key": "AGENT_MODEL"
        }
      },
      {
        "id": "D3",
        "what": "the source default in core/llm.py",
        "when": {
          "always": true
        },
        "value_from": {
          "literal": "gpt-4o-mini"
        },
        "_evidence": "read, not bitten, and now known to be mechanistically doubtful: the D4 withdrawal showed the journal's value does not reach the record by the route this rule assumes. The literal is right in every evaluation measured; the explanation is UNPROVEN."
      }
    ],
    "_withdrawn_rules": [
      {
        "id": "D4",
        "was": "AGENT_PROVIDER=local selects LOCAL_LLM_MODEL before AGENT_MODEL is consulted",
        "source_reading": "core/llm.py:28 reads AGENT_PROVIDER, and :32 takes the local branch before the AGENT_MODEL override at :35",
        "measurement": "WITHDRAWN. With AGENT_PROVIDER=local the observed llm_model stayed gpt-4o-mini, so the rule predicted qwen-local and the validator returned PRECEDENCE_VIOLATED — the certificate's own self-check caught the certificate.",
        "status": "AGENT_PROVIDER is a source-visible dependency that measurement shows INERT for this claim in this evaluation — the QT5 pattern, found again from the inside",
        "residue": "the mechanism that DOES produce the journal's llm_model is UNRESOLVED; the router in core/model_router.py is the next place to look, and until then D3 names a value that is right and an explanation that is not proven"
      }
    ]
  },
  "currency": {
    "_why_no_repository_hash": "QT3 measured that the complete tracked snapshot — 751 files, 7043297867c02b8d — is unchanged by a mutation that falsifies this claim. A file hash would be a currency signal structurally blind to this claim's active dependency.",
    "instead": "currency is re-established by RE-EVALUATION; there is no cached verdict to go stale.",
    "known_gap": "re-evaluation costs a process launch and says nothing about evaluations other than the one it ran."
  },
  "status_vocabulary": {
    "VALID": "in domain, evidence bound to this evaluation, observed value equals the expected value, and the dependency model predicted it",
    "INVALID": "in domain, evidence bound, and the observed value differs from the expected value",
    "OUT_OF_DOMAIN": "no evidence could be bound to this evaluation — no new journal, no matching event, or the projection is absent",
    "PRECEDENCE_VIOLATED": "the observation disagrees with what the dependency model predicts. This is a defect of the CERTIFICATE, not of the claim, and it is reported even when the claim itself happens to hold."
  }
}
