      },
      "freshness_semantics": {
        "on_hash_mismatch": "STALE — the target moved, the properties must be re-verified; NOT by itself a broken relationship",
        "on_property_failure": "BROKEN — the asserted semantic relationship is false",
        "why_separate": "the audit's own finding: a structural signal that fires on any edit cannot be counted as behavioural evidence. The validator must be able to say STALE without saying BROKEN, and this specimen is the first place that distinction is machine-checked."
      },
      "resolver": {
        "kind": "powershell_ast",
        "bridge": "scripts/qm_ps_anchor.ps1",
        "_why": "the first draft of this experiment matched braces textually. Rejected on the operator's ruling: the first .qm semantic link must not depend on a parser weaker than the language it claims to observe. Facts below are extracted with PowerShell's own Parser and the assertions are compared against those facts, not against the file's text."
      },
      "verified_properties": [
        {
          "id": "P1",
          "claim": "the anchor exists in the target file and the target parses",
          "assertions": [
            {
              "path": "parse_ok",
              "op": "equals",
              "value": true
            },
            {
              "path": "anchor_found",
              "op": "equals",
              "value": true
